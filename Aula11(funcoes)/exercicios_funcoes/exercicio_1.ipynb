    "# # Crie uma função que receba o preço de um produto e a porcentagem de desconto aplicada.\n",
    "# A função deve retornar o valor final do produto.\n",
    "\n",
    "def valor_final(preco,desconto):\n",
    "     valor_f = preco * (desconto) * 0.1\n",
    "     return valor_f\n",
    "     \n",
    "valor_final(100,5)\n",
    "print(valor_final)"
   ]
  }
